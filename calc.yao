# 爻 · 算   —— 一台科学计算器的输入状态机
#
# 语言不给浮点数、不给变量、不给字符串，这是 SPEC 定下的分工：
# 爻只拥有「按键序列是否合法、现在处于什么输入模式」，
# 数值本身交给宿主（浏览器里的 JS）。
#
# 6 位状态装不下「相位 + 括号深度」，于是把它劈成两半：
#
#   本（低 6 位） = 相位，就是下面 7 个 态
#   动（高 6 位） = 括号深度 0..63
#
#   state = 变(相位, 深度)
#
# 这不是凑数：转移只按 `本` 匹配，于是 7×64 种组合只需要 7 组规则，
# 深度则以位运算的形式在目标里流动（`变(输入, 动(变) + 1)`）。
# 与 examples/traffic 把秒数塞进高 3 位是同一手法。
#
# 7 个相位：
#   空白  刚清空，什么都没输入
#   输入  刚输入完一个操作数（数字 / 常数 / 收尾的右括号）
#   待符  刚输入一个二元运算符，等着右操作数
#   括号  刚输入左括号，等着括号里的第一个操作数
#   收括  刚输入右括号，一个带括号的操作数结束了
#   结果  等号求值完毕
#   出错  按键序列非法 / 求值失败 / 括号不配平
#
# 非法按键的写法就是「不写规则」——解释器返回「此路不通」，
# 宿主据此拒绝按键并给出提示。校验器会把 4096 个状态全部走一遍。

机 计算器 {
  # ---------------------------------------------------------------- 事件
  事 数字                 # 0..9
  事 小数点               # .
  事 运算符(位 号)        # 1 +  2 -  3 ×  4 ÷  5 ^  6 %
  事 左括号               # (
  事 右括号               # )
  事 常数(位 号)          # 1 π  2 e  3 Ans
  事 三角函数(位 号)      # 1 sin 2 cos 3 tan 4 asin 5 acos 6 atan
  事 对数函数(位 号)      # 1 ln  2 lg  3 log₂ 4 e^x 5 10^x 6 sinh
  事 幂函数(位 号)        # 1 √   2 ∛   3 x²   4 x³   5 1/x  6 |x|
  事 阶乘                 # x!
  事 负号                 # ±
  事 等号                 # =
  事 清除                 # C
  事 出错                 # 宿主发现异常时送进来

  # ---------------------------------------------------------------- 态
  态 空白 = 0
  态 输入 = 1
  态 待符 = 2
  态 括号 = 3
  态 收括 = 4
  态 结果 = 5
  态 出错 = 6

  # ---------------------------------------------------------------- 清空
  # 任何相位按 C 都回到空白，深度归零。
  转 * 清除 -> 变(空白, 0)
  转 * 出错 -> 变(出错, 0)

  # ---------------------------------------------------------------- 左括号
  # 除了「出错」，每个相位都能开括号；括号深度加一（63 封顶）。
  转 * 左括号 -> 若 动(变) < 63 {
    变(括号, 动(变) + 1)
  } 否则 {
    变(出错, 0)
  }

  # ---------------------------------------------------------------- 数字
  转 空白 数字 -> 变(输入, 0)
  转 输入 数字 -> 变(输入, 动(变))
  转 待符 数字 -> 变(输入, 动(变))
  转 括号 数字 -> 变(输入, 动(变))
  转 收括 数字 -> 变(输入, 动(变))   # 隐式乘号由宿主补
  转 结果 数字 -> 变(输入, 0)        # 从结果开始新表达式
  转 出错 数字 -> 变(输入, 0)        # 出错后按数字即重来

  # ---------------------------------------------------------------- 小数点
  转 空白 小数点 -> 变(输入, 0)
  转 输入 小数点 -> 变(输入, 动(变))
  转 待符 小数点 -> 变(输入, 动(变))
  转 括号 小数点 -> 变(输入, 动(变))
  转 收括 小数点 -> 变(输入, 动(变))
  转 结果 小数点 -> 变(输入, 0)
  转 出错 小数点 -> 变(输入, 0)

  # ---------------------------------------------------------------- 二元运算符
  # 空白 / 括号 后面不能直接接运算符（负号请用 ± 键）。
  转 输入 运算符 -> 变(待符, 动(变))
  转 待符 运算符 -> 变(待符, 动(变))  # 连按运算符 = 换掉上一个
  转 收括 运算符 -> 变(待符, 动(变))
  转 结果 运算符 -> 变(待符, 0)      # 拿上一次的结果接着算

  # ---------------------------------------------------------------- 右括号
  # 深度为 0 时按 ) 是错，机器直接把状态推到出错。
  转 输入 右括号 -> 若 动(变) > 0 {
    变(收括, 动(变) - 1)
  } 否则 {
    变(出错, 0)
  }
  转 收括 右括号 -> 若 动(变) > 0 {
    变(收括, 动(变) - 1)
  } 否则 {
    变(出错, 0)
  }

  # ---------------------------------------------------------------- 常数
  转 空白 常数 -> 变(输入, 0)
  转 输入 常数 -> 变(输入, 动(变))
  转 待符 常数 -> 变(输入, 动(变))
  转 括号 常数 -> 变(输入, 动(变))
  转 收括 常数 -> 变(输入, 动(变))
  转 结果 常数 -> 变(输入, 0)

  # ---------------------------------------------------------------- 一元函数
  # 函数作用在紧邻的操作数上（sin 在 30 之后按），相位不变。
  转 输入 三角函数 -> 变(输入, 动(变))
  转 收括 三角函数 -> 变(收括, 动(变))
  转 结果 三角函数 -> 变(结果, 0)

  转 输入 对数函数 -> 变(输入, 动(变))
  转 收括 对数函数 -> 变(收括, 动(变))
  转 结果 对数函数 -> 变(结果, 0)

  转 输入 幂函数 -> 变(输入, 动(变))
  转 收括 幂函数 -> 变(收括, 动(变))
  转 结果 幂函数 -> 变(结果, 0)

  转 输入 阶乘 -> 变(输入, 动(变))
  转 收括 阶乘 -> 变(收括, 动(变))
  转 结果 阶乘 -> 变(结果, 0)

  转 输入 负号 -> 变(输入, 动(变))
  转 收括 负号 -> 变(收括, 动(变))
  转 结果 负号 -> 变(结果, 0)

  # ---------------------------------------------------------------- 等号
  # 括号没闭合时宿主会先补发若干个 右括号，再发 等号。
  转 输入 等号 -> 变(结果, 0)
  转 收括 等号 -> 变(结果, 0)
  转 结果 等号 -> 变(结果, 0)        # 连按 = 不报错，也不重复计算

  起 空白
}
